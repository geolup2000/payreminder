<!doctype html>
<html lang="<%= language %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>PayReminder</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/app-icon-192.png">
<meta name="theme-color" content="#090d17">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="public-shell">
  <div class="public-brand"><span class="brand-mark">P</span>PayReminder</div>
  <main class="public-main">
    <section class="public-intro">
      <div class="public-art" aria-hidden="true"><span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="art-check">✓</span><span class="art-spark spark-one">✦</span><span class="art-spark spark-two">✦</span></div>
      <h1>Plățile recurente,<br><span>fără griji.</span></h1>
      <p>Un loc simplu pentru reamintiri, plăți și confirmări lunare.</p>
      <a class="btn btn-indigo" href="/admin">Accesează panoul <span aria-hidden="true">→</span></a>
    </section>
    <footer class="muted">PayReminder <span>·</span> Plăți organizate, în fiecare lună</footer>
  </main>
</div>
<script src="/i18n.js"></script>
<script src="/pwa.js" defer></script>
</body>
</html>
