<!doctype html>
<html lang="<%= language %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Setări - PayReminder</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#090d17">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('../partials/admin-head', { currentPath: '/admin/settings' }) %>

  <div class="title">Setări</div>
  <p class="subtitle">Configurează limba aplicației și notificările de plată.</p>

  <% if (saved) { %><div class="alert alert-ok">Setările au fost salvate.</div><% } %>
  <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>

  <div class="card" style="max-width:560px">
    <form method="post" action="/admin/settings">
      <div class="form-group">
        <label for="language">Limba aplicației</label>
        <select id="language" name="language">
          <option value="ro" <%= language === 'ro' ? 'selected' : '' %>>Română</option>
          <option value="en" <%= language === 'en' ? 'selected' : '' %>>English</option>
        </select>
        <p class="muted" style="margin:6px 0 0">Se aplică interfeței aplicației și emailurilor de reamintire și confirmare.</p>
      </div>
      <h2>Notificări</h2>
      <div class="form-group">
        <label for="notificationAgent">Agent</label>
        <select id="notificationAgent">
          <option value="telegram">Telegram</option>
          <option value="discord" <%= notifications.discord.active && !notifications.telegram.active ? 'selected' : '' %>>Discord</option>
        </select>
        <p class="muted">Poți activa separat fiecare agent. Modificările se aplică după salvare.</p>
      </div>
      <% for (const agent of ['telegram', 'discord']) { %>
      <section data-agent="<%= agent %>">
        <div class="form-group">
          <label><input type="checkbox" name="<%= agent %>Active" data-active <%= notifications[agent].active ? 'checked' : '' %>> Activ</label>
        </div>
        <div data-fields <%= notifications[agent].active ? '' : 'hidden' %>>
          <% if (agent === 'telegram') { %>
          <div class="form-group">
            <label for="telegramBotToken">Tokenul botului Telegram</label>
            <input id="telegramBotToken" name="telegramBotToken" type="password" autocomplete="new-password" value="<%= notifications.telegram.botToken %>">
          </div>
          <div class="form-group">
            <label for="telegramChatId">ID-ul conversației Telegram</label>
            <input id="telegramChatId" name="telegramChatId" type="text" value="<%= notifications.telegram.chatId %>">
          </div>
          <% } else { %>
          <div class="form-group">
            <label for="discordWebhookUrl">Adresa webhookului Discord</label>
            <input id="discordWebhookUrl" name="discordWebhookUrl" type="password" autocomplete="new-password" value="<%= notifications.discord.webhookUrl %>">
          </div>
          <div class="form-group">
            <label for="discordAppName">Nume aplicație</label>
            <input id="discordAppName" name="discordAppName" type="text" maxlength="80" value="<%= notifications.discord.appName %>">
            <p class="muted">Imaginea de profil folosește automat iconul PayReminder.</p>
          </div>
          <% } %>
        </div>
      </section>
      <% } %>
      <div class="button-row"><button class="btn btn-indigo" type="submit">Salvează setările</button></div>
    </form>
  </div>

<script>
  const agentSelect = document.getElementById('notificationAgent');
  const agentSections = document.querySelectorAll('[data-agent]');
  function updateNotificationFields() {
    for (const section of agentSections) {
      section.hidden = section.dataset.agent !== agentSelect.value;
      section.querySelector('[data-fields]').hidden = !section.querySelector('[data-active]').checked;
    }
  }
  agentSelect.addEventListener('change', updateNotificationFields);
  for (const checkbox of document.querySelectorAll('[data-active]')) {
    checkbox.addEventListener('change', updateNotificationFields);
  }
  updateNotificationFields();
</script>
<%- include('../partials/admin-foot', { currentPath: '/admin/settings' }) %>
</body>
</html>
