# =====================================================
# PayReminder - configuration
# Copy this file as ".env" and fill in the values.
# =====================================================

# Port the application runs on
PORT=3000

# HTTP(S) origin of the application (used in emails); no path, query, or credentials.
# This does not restrict which network interfaces the server listens on.
# For local testing, keep http://localhost:3000
APP_URL=http://localhost:3000

# Optional comma-separated trusted reverse-proxy IP addresses/CIDRs; blank = none.
# Set only to the actual proxy peers. Never trust arbitrary clients or 0.0.0.0/0.
# Example for a proxy on this same host: 127.0.0.1/32,::1/128
# The proxy must overwrite client forwarding headers; restrict direct port access.
TRUST_PROXY=

# =====================================================
# ADMIN
# =====================================================
# Admin panel username
ADMIN_USER=admin

# Admin panel password: unique, at least 12 characters. Required before startup.
# Blank intentionally; example/default passwords are rejected. install.sh generates it.
ADMIN_PASSWORD=

# Session signing secret: random, at least 32 characters. Required before startup.
# Blank intentionally. install.sh generates a cryptographically random secret.
SESSION_SECRET=

# =====================================================
# EMAIL - SMTP
# =====================================================
# Fill in the details provided by your email service.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ===== Sender address (send-from) =====
# If your SMTP account allows sending from a different address (e.g. an address on your domain),
# enter the sender name and address here.
# If SMTP_FROM_ADDRESS is left blank, SMTP_USER is used as the sender address.
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=

# Notifications (Telegram / Discord) are configured in Admin → Settings.

# =====================================================
# PAYMENTS
# =====================================================
# Currency to display
CURRENCY=RON

# The sending schedule is configured in the admin panel for each service.

# Default amount suggested when adding a user (can be changed for each user)
DEFAULT_AMOUNT=15

# Name of the first service, created automatically if none exists
DEFAULT_SERVICE_NAME=Service

# Send the user a payment confirmation email when you confirm a payment (true/false)
SEND_CONFIRM_TO_MEMBER=true
